{
  "name": "tier2-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-side glue between cross_chain_1 frontend and tier2_wallet primitives. Bundles to a single ESM file the frontend imports directly.",
  "type": "module",
  "scripts": {
    "build": "esbuild src/adapter.ts --bundle --format=esm --target=es2022 --platform=browser --outfile=../frontend/tier2-adapter.bundle.js --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@starkware-libs/starknet-privacy-sdk": "file:../../../privacy/starknet-privacy/sdk",
    "starknet": "^10.0.2",
    "tier2-wallet": "file:../../tier2_wallet"
  },
  "devDependencies": {
    "esbuild": "^0.23.1",
    "typescript": "^5.4.0",
    "@types/node": "^20.11.0"
  }
}
