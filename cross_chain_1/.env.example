# =============================================================================
# cross_chain/.env  —  copy to cross_chain/.env and fill in
# =============================================================================
# This file is loaded by both the eth_sender forge scripts (which read it
# automatically when run from `cross_chain/eth_sender/`) and by the
# Starknet deploy helper (`cross_chain/scripts/deploy_starknet.sh`).
#
# DO NOT COMMIT THIS FILE WITH REAL VALUES.
# `.gitignore` excludes `.env` but NOT `.env.example`.

# ---------- Ethereum Sepolia (sender side) ----------

# Your Ethereum Sepolia RPC. Free tier from Alchemy/Infura/QuickNode is fine.
# Example: https://sepolia.infura.io/v3/<YOUR_KEY>
SEPOLIA_RPC_URL=

# Deployer private key — MUST be 0x-prefixed.
# This account pays for:
#   1. Deploying StringSender (~0.005 ETH gas)
#   2. setPeer call         (~0.0002 ETH gas)
#   3. The send itself      (~0.0001 ETH gas + LayerZero native fee, usually ~0.0001 ETH)
# Total ~0.01 sepolia ETH. Faucet: https://www.alchemy.com/faucets/ethereum-sepolia
PRIVATE_KEY=

# Optional: Etherscan API key for `--verify` flag on `forge script`.
ETHERSCAN_API_KEY=

# ---------- Starknet Sepolia (receiver side) ----------

# Public Starknet Sepolia RPC. BlastAPI's free endpoint shut down in 2026.
# Working public option:
#   https://api.cartridge.gg/x/starknet/sepolia              (spec 0.9.0)
STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# sncast account name that will sign Starknet txs. Created by deploy_starknet.sh
# (or by `sncast account create` if you already have one).
STARKNET_ACCOUNT=cross_chain_deployer

# Where sncast keeps the account file. Local to this project so we don't
# pollute ~/.starknet_accounts.
STARKNET_ACCOUNTS_FILE=./accounts.json

# Optional Voyager API key for contract verification.
VOYAGER_API_KEY=

# ---------- LayerZero V2 (filled in for you — Sepolia values) ----------

# EVM EndpointV2 on Ethereum Sepolia
LZ_ENDPOINT=0x6EDCE65403992e310A62460808c4b910D972f10f

# Cairo EndpointV2 on Starknet Sepolia
LZ_ENDPOINT_STARKNET=0x0316d70a6e0445a58c486215fac8ead48d3db985acde27efca9130da4c675878

# STRK token (used by the OApp constructor's `native_token` arg)
STRK_ADDRESS=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# Destination EID seen FROM Ethereum  → Starknet Sepolia
DST_EID_STARKNET=40500

# Destination EID seen FROM Starknet  → Ethereum Sepolia
DST_EID_ETHEREUM=40161

# ---------- Deployment outputs (populated as we go) ----------

# Filled after StringReceiver is deployed on Starknet.
STARKNET_OAPP_ADDRESS=

# Filled after StringSender is deployed on Ethereum Sepolia.
SENDER_ADDRESS=

# Auto-derived from STARKNET_OAPP_ADDRESS by deploy script (it's the same value
# left-padded to 32 bytes — Starknet addresses are already 32 bytes).
STARKNET_PEER_BYTES32=

# Set this just before calling Send.s.sol.
MESSAGE="hello from ethereum"

# ---------- Counter v3 (ABA) ----------
# Cairo Counter v3 (Starknet Sepolia)
COUNTER_V3_STARKNET=
# Solidity CounterTrigger v3 (Ethereum Sepolia)
COUNTER_V3_ETH=
# 32-byte zero-padded Cairo address, used by setPeer on the EVM side
COUNTER_V3_STARKNET_PEER_BYTES32=
# Return-leg defaults (used by 14_set_return_options.sh)
RETURN_LEG_GAS=200000
RETURN_LEG_VALUE=0
# Amount of STRK (in wei, i.e. 10^18 = 1 STRK) to pre-fund Counter v3 with
COUNTER_V3_STRK_FUND_AMOUNT=4000000000000000000
